{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: current file (project root)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONUTF8": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: current file, save outputs only (--no-show)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": ["--no-show"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONUTF8": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Run unit tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "-s", "tests", "-v"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONUTF8": "1"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
